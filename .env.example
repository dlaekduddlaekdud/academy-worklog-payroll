# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관리자의 근무자 계정 생성에만 사용. 서버 전용이므로 NEXT_PUBLIC 접두사 금지.
SUPABASE_SERVICE_ROLE_KEY=

# Notion 근무 일정 연동 (선택). 비워두면 일정 캘린더가 빈 상태로 동작한다.
NOTION_TOKEN=
NOTION_SCHEDULE_DB_ID=

# RPC 통합 테스트용. supabase/seed.sql로 만든 관리자 계정을 쓴다.
# 비워두면 통합 테스트는 건너뛴다.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
